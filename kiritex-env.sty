\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kiritex-env}[2026/08/19 v1.0.4 KiriTeX problem environments]
\RequirePackage{xparse}

% ---- safety fallbacks for class conditionals ----
\@ifundefined{if@kiritex@pad}{\newif\if@kiritex@pad\@kiritex@padfalse}{}
\@ifundefined{if@kiritex@answers}{\newif\if@kiritex@answers\@kiritex@answersfalse}{}

% ---- problem counter (shared across all problem types) ----
\newcounter{problem}[section]
\renewcommand{\theproblem}{\thesection.\arabic{problem}}

% Numbering policy:
% Section headings and problem bodies must contain semantic text only. Do not
% manually write numbers such as "1.", "第 1 节", or "题 1.1" in titles or
% problem text; KiriTeX owns all visible numbering through counters below.
% Subparts use (1), (2), ... at the left edge; do not hand-write subpart labels.

% ---- problem label helper ----
\NewDocumentCommand{\kt@problem@head}{}{%
  \refstepcounter{problem}%
  \par\medskip\noindent
  \if@kiritex@answersection\kt@answerstart\fi
  \textbf{题 \theproblem}%
  \quad
}

% ---- fill-in blank command ----
% Use \problemblock inside a sentence. Use \problemblock* at sentence end; the
% starred form appends an un-underlined Chinese full stop after the blank.
\NewDocumentCommand{\problemblock}{s}{%
  \underline{\quad\quad\quad\quad\quad\quad}%
  \IfBooleanT{#1}{。}%
}

% ---- optional answer output ----
% Hidden by default. Use \documentclass[answers]{kiritex} to print answers.
\NewDocumentCommand{\answer}{m}{%
  \if@kiritex@answersection
    \kt@answercollect{#1}%
  \else
    \if@kiritex@answers
      \par\smallskip
      \noindent{\textcolor{kiriteal}{\bfseries 参考答案}}\quad #1%
      \par\smallskip
    \fi
  \fi
}


% ---- linked answer appendix (opt-in) ----
\ExplSyntaxOn
\seq_new:N \g__kiritex_answers_seq
\int_new:N \g__kiritex_problem_anchor_int
\int_new:N \g__kiritex_answer_anchor_int
\tl_new:N \l__kiritex_problem_anchor_tl
\prop_new:N \g__kiritex_answer_links_prop
\tl_new:N \l__kiritex_answer_links_tl
\cs_generate_variant:Nn \prop_get:NnNTF { NV }
\cs_generate_variant:Nn \prop_get:NnNT { NV }
\cs_generate_variant:Nn \prop_gput:Nnn { NVV }
\cs_generate_variant:Nn \prop_gremove:Nn { NV }

\cs_new_protected:Npn \kt@answerstart
  {
    \int_gincr:N \g__kiritex_problem_anchor_int
    \tl_set:Nx \l__kiritex_problem_anchor_tl
      {. \int_use:N \g__kiritex_problem_anchor_int }
    \hypertarget{kiri:problem\l__kiritex_problem_anchor_tl}{}
  }

\cs_new_protected:Npn \kt@answercollect #1
  {
    \tl_if_empty:NTF \l__kiritex_problem_anchor_tl
      { \PackageError{kiritex-env}{Answer~outside~a~problem}{Put~the~answer~inside~a~KiriTeX~problem~environment.} }
      {
        \int_gincr:N \g__kiritex_answer_anchor_int
        \prop_get:NVNTF \g__kiritex_answer_links_prop
          \l__kiritex_problem_anchor_tl \l__kiritex_answer_links_tl
          { }
          { \tl_clear:N \l__kiritex_answer_links_tl }
        \tl_put_right:Nx \l__kiritex_answer_links_tl
          {
            \exp_not:N \__kiritex_answer_button:nn
              {kiri:answer.\int_use:N \g__kiritex_answer_anchor_int}{查看答案}
            \exp_not:N \quad
          }
        \prop_gput:NVV \g__kiritex_answer_links_prop
          \l__kiritex_problem_anchor_tl \l__kiritex_answer_links_tl
        % Freeze the label and destinations while preserving the answer tokens.
        \seq_gput_right:Nx \g__kiritex_answers_seq
          {
            \exp_not:N \__kiritex_print_answer:nnnn
              {\theproblem}
              {kiri:problem\l__kiritex_problem_anchor_tl}
              {kiri:answer.\int_use:N \g__kiritex_answer_anchor_int}
              {\exp_not:n {#1}}
          }
      }
  }

\cs_new_protected:Npn \__kiritex_answer_button:nn #1#2
  { \hyperlink{#1}{\colorbox{kirinavylight}{\strut\enspace #2\enspace}} }

\cs_new_protected:Npn \kt@answerfinish
  {
    \prop_get:NVNT \g__kiritex_answer_links_prop
      \l__kiritex_problem_anchor_tl \l__kiritex_answer_links_tl
      {
        \par\smallskip\noindent\tl_use:N \l__kiritex_answer_links_tl
        \prop_gremove:NV \g__kiritex_answer_links_prop \l__kiritex_problem_anchor_tl
      }
  }

\cs_new_protected:Npn \__kiritex_print_answer:nnnn #1#2#3#4
  {
    \par\medskip\noindent\hypertarget{#3}{}
    \textbf{题~#1}\quad\__kiritex_answer_button:nn {#2}{返回原题}
    \par\smallskip #4\par
    \if@kiritex@pad\clearpage\fi
  }

\AtEndDocument
  {
    \seq_if_empty:NF \g__kiritex_answers_seq
      {
        \clearpage
        \section*{参考答案}
        \markboth{参考答案}{参考答案}
        \addcontentsline{toc}{section}{参考答案}
        \seq_map_inline:Nn \g__kiritex_answers_seq {#1}
      }
  }
\ExplSyntaxOff

% ---- subparts under one problem ----
\newcounter{kt@subproblem}
\newenvironment{problemsubparts}{%
  \par\smallskip
  \begin{list}{(\arabic{kt@subproblem})}{%
    \usecounter{kt@subproblem}%
    \setlength{\leftmargin}{0pt}%
    \setlength{\labelwidth}{1.8em}%
    \setlength{\labelsep}{0.5em}%
    \setlength{\itemindent}{\dimexpr\labelwidth+\labelsep\relax}%
    \setlength{\listparindent}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\itemsep}{0.25\baselineskip}%
  }%
}{%
  \end{list}%
  \par\smallskip
}

% ============================================================
% 1. Standard problem
% ============================================================
\NewDocumentEnvironment{problem}{}{%
  \kt@problem@head
}{%
  \if@kiritex@answersection\kt@answerfinish\fi
  \par\medskip
  \if@kiritex@pad\clearpage\fi
}

% ============================================================
% 2. True/False problem
%    Renders only the generated problem label and the statement text.
%    No trailing parentheses, blanks, or rules are added.
% ============================================================
\NewDocumentEnvironment{problemtf}{}{%
  \kt@problem@head
}{%
  \if@kiritex@answersection\kt@answerfinish\fi
  \par\medskip
  \if@kiritex@pad\clearpage\fi
}

% ============================================================
% 3. Multiple choice problem
%    Prompt text must not end with closing punctuation.
%    Options auto-labeled A, B, C, D.
%    Layout auto-detects 1, 2, or 4 options per row based on option widths.
%    No trailing parentheses, blanks, or rules are added.
% ============================================================

% Internal storage
\newcounter{kt@choice@num}
\newdimen\kt@choice@maxw

% Storage for up to 8 option texts
\newcommand{\kt@choice@a}{}
\newcommand{\kt@choice@b}{}
\newcommand{\kt@choice@c}{}
\newcommand{\kt@choice@d}{}
\newcommand{\kt@choice@e}{}
\newcommand{\kt@choice@f}{}
\newcommand{\kt@choice@g}{}
\newcommand{\kt@choice@h}{}

% Helper: get letter from counter value
\newcommand{\kt@choice@letter}{%
  \ifcase\value{kt@choice@num}\or A\or B\or C\or D\or E\or F\or G\or H\fi
}

\NewDocumentEnvironment{problemchoice}{}{%
  \kt@problem@head
  \setcounter{kt@choice@num}{0}%
  \global\kt@choice@maxw=0pt\relax
  \let\kt@choice@a\@empty
  \let\kt@choice@b\@empty
  \let\kt@choice@c\@empty
  \let\kt@choice@d\@empty
  \let\kt@choice@e\@empty
  \let\kt@choice@f\@empty
  \let\kt@choice@g\@empty
  \let\kt@choice@h\@empty
  \def\choice##1{%
    \stepcounter{kt@choice@num}%
    \settowidth{\@tempdima}{\textbf{\kt@choice@letter}.~##1}%
    \ifdim\@tempdima>\kt@choice@maxw\global\kt@choice@maxw=\@tempdima\fi
    \ifcase\value{kt@choice@num}%
      \or\gdef\kt@choice@a{##1}%
      \or\gdef\kt@choice@b{##1}%
      \or\gdef\kt@choice@c{##1}%
      \or\gdef\kt@choice@d{##1}%
      \or\gdef\kt@choice@e{##1}%
      \or\gdef\kt@choice@f{##1}%
      \or\gdef\kt@choice@g{##1}%
      \or\gdef\kt@choice@h{##1}%
    \fi
  }%
}{%
  \kt@render@choices
  \if@kiritex@answersection\kt@answerfinish\fi
  \par\medskip
  \if@kiritex@pad\clearpage\fi
}

% Render collected choices with auto layout
\newcommand{\kt@render@choices}{%
  \par\vspace{4pt}%
  \ifnum\value{kt@choice@num}=0\relax
    % no choices
  \else
    \ifdim\kt@choice@maxw>0.47\textwidth
      \kt@render@choices@one
    \else
      \ifdim\kt@choice@maxw>0.24\textwidth
        \kt@render@choices@two
      \else
        \kt@render@choices@four
      \fi
    \fi
  \fi
}

% Render choices as one option per row
\newcommand{\kt@render@choices@one}{%
  \ifx\kt@choice@a\@empty\else\noindent\textbf{A}.~\kt@choice@a\par\fi
  \ifx\kt@choice@b\@empty\else\noindent\textbf{B}.~\kt@choice@b\par\fi
  \ifx\kt@choice@c\@empty\else\noindent\textbf{C}.~\kt@choice@c\par\fi
  \ifx\kt@choice@d\@empty\else\noindent\textbf{D}.~\kt@choice@d\par\fi
  \ifx\kt@choice@e\@empty\else\noindent\textbf{E}.~\kt@choice@e\par\fi
  \ifx\kt@choice@f\@empty\else\noindent\textbf{F}.~\kt@choice@f\par\fi
  \ifx\kt@choice@g\@empty\else\noindent\textbf{G}.~\kt@choice@g\par\fi
  \ifx\kt@choice@h\@empty\else\noindent\textbf{H}.~\kt@choice@h\par\fi
}

% Render choices as two options per row
\newcommand{\kt@render@choices@two}{%
  \begingroup
  \setlength{\tabcolsep}{0pt}%
  \noindent\begin{tabular}{@{}p{0.49\textwidth}@{\hspace{0.02\textwidth}}p{0.49\textwidth}@{}}
    \ifx\kt@choice@a\@empty\else\textbf{A}.~\kt@choice@a\fi &
    \ifx\kt@choice@b\@empty\else\textbf{B}.~\kt@choice@b\fi \\
    \ifx\kt@choice@c\@empty\else\textbf{C}.~\kt@choice@c\fi &
    \ifx\kt@choice@d\@empty\else\textbf{D}.~\kt@choice@d\fi \\
    \ifx\kt@choice@e\@empty\else\textbf{E}.~\kt@choice@e\fi &
    \ifx\kt@choice@f\@empty\else\textbf{F}.~\kt@choice@f\fi \\
    \ifx\kt@choice@g\@empty\else\textbf{G}.~\kt@choice@g\fi &
    \ifx\kt@choice@h\@empty\else\textbf{H}.~\kt@choice@h\fi \\
  \end{tabular}%
  \endgroup
}

% Render choices as four options per row
\newcommand{\kt@render@choices@four}{%
  \begingroup
  \setlength{\tabcolsep}{0pt}%
  \noindent\begin{tabular}{@{}p{0.235\textwidth}@{\hspace{0.02\textwidth}}p{0.235\textwidth}@{\hspace{0.02\textwidth}}p{0.235\textwidth}@{\hspace{0.02\textwidth}}p{0.235\textwidth}@{}}
    \ifx\kt@choice@a\@empty\else\textbf{A}.~\kt@choice@a\fi &
    \ifx\kt@choice@b\@empty\else\textbf{B}.~\kt@choice@b\fi &
    \ifx\kt@choice@c\@empty\else\textbf{C}.~\kt@choice@c\fi &
    \ifx\kt@choice@d\@empty\else\textbf{D}.~\kt@choice@d\fi \\
    \ifx\kt@choice@e\@empty\else\textbf{E}.~\kt@choice@e\fi &
    \ifx\kt@choice@f\@empty\else\textbf{F}.~\kt@choice@f\fi &
    \ifx\kt@choice@g\@empty\else\textbf{G}.~\kt@choice@g\fi &
    \ifx\kt@choice@h\@empty\else\textbf{H}.~\kt@choice@h\fi \\
  \end{tabular}%
  \endgroup
}
\endinput
